# Generated outputs are regeneratable; never commit them.
output/
.coverage
.coverage.*
# Coverage JSON export is a regeneratable snapshot that drifts from the live
# pytest --cov gate; keep a single authoritative coverage number (the gate +
# PUBLICATION_READINESS.md) rather than a tracked, staleness-prone copy.
coverage_project.json
.pytest_cache/
__pycache__/
*.pyc
.benchmarks/

# Egg-info / build artifacts.
**/*.egg-info/
build/
dist/

# Project-local virtualenvs (the root .venv is shared).
.venv/
data/longmemeval/

# Environment / secrets.
.env
